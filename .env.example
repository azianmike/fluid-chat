# Required
DATABASE_URL=postgres://fluidchat:fluidchat@localhost:5432/fluidchat
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-at-least-32-characters

# Realtime. REDIS_URL is optional for a single-node install; without it the app
# posts events straight to the realtime server.
# REDIS_URL=redis://localhost:6379
REALTIME_PORT=3001
REALTIME_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
REALTIME_TOKEN=

# S3-compatible object storage (Cloudflare R2 uses region "auto"). Uploads and
# workspace exports are never written to local disk.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# Set true for local MinIO and other providers that require path-style URLs.
S3_FORCE_PATH_STYLE=false

# Email (unset SMTP_HOST logs emails instead of sending them)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Fluid Chat <noreply@example.com>

# Optional
ENABLE_LINK_UNFURL=false
FREE_WORKSPACE_LIMIT=0
STRIPE_SECRET_KEY=
