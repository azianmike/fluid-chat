# Required
DATABASE_URL=postgres://openchat:openchat@localhost:5432/openchat
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-at-least-32-characters

# Realtime. REDIS_URL is optional for a single-node install; without it the app
# posts events straight to the realtime server.
# REDIS_URL=redis://localhost:6379
REALTIME_PORT=3001
REALTIME_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
REALTIME_TOKEN=

# Files
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=26214400
EXPORT_DIR=./exports

# Email (unset SMTP_HOST logs emails instead of sending them)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OpenChat <noreply@example.com>

# Optional
ENABLE_LINK_UNFURL=false
FREE_WORKSPACE_LIMIT=0
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
STRIPE_SECRET_KEY=
